{
  "name": "@divya/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Python ingest service, driven through Turborepo via uv",
  "scripts": {
    "setup": "uv sync --python 3.13",
    "dev": "uv run python -m app",
    "dev:lan": "uv run python -m app",
    "start": "uv run python -m app --no-reload",
    "test": "uv run pytest -q",
    "simulate": "uv run python scripts/simulate_phones.py"
  }
}
