# Copy to .env at the repo root. Every value here is optional.

# ---- How phones reach this machine --------------------------------------
# Leave empty on the same Wi-Fi: the QR code uses https://<your-LAN-IP>:3000.
# If you run `ngrok http 3000`, paste the https forwarding URL here instead.
PUBLIC_BASE_URL=

# ---- Ingest service (Python) --------------------------------------------
INGEST_HOST=0.0.0.0
INGEST_PORT=8000
# Where the Next.js server proxies /api/* to.
INGEST_URL=http://127.0.0.1:8000

# Frames per second that go through the processing path (quality, preview,
# and later detection). Phones still capture at up to 30 FPS.
PROCESS_FPS=12
PREVIEW_WIDTH=640
JPEG_QUALITY=72
BUFFER_SECONDS=10
MAX_CAMERAS=6
SESSION_TTL_SECONDS=600

# ICE. STUN is enough on one Wi-Fi. Add TURN if phones are on mobile data.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Web -----------------------------------------------------------------
# Dashboard -> ingest websocket. Defaults to ws://<dashboard-host>:8000.
NEXT_PUBLIC_INGEST_WS_URL=
